{
  "manifest_version": 3,
  "name": "Local Social Media Archiver",
  "version": "0.2.6",
  "description": "Save images and videos from the post you're viewing to Eagle or your Downloads folder, with the caption, author, and link.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save post media locally",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "save-to-eagle": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Save the open post to Eagle"
    },
    "save-to-downloads": {
      "suggested_key": {
        "default": "Alt+Shift+D"
      },
      "description": "Save the open post to Downloads"
    }
  },
  "permissions": [
    "activeTab",
    "scripting",
    "downloads",
    "contextMenus",
    "storage"
  ],
  "host_permissions": [
    "https://www.instagram.com/*",
    "https://www.threads.com/*",
    "https://www.threads.net/*",
    "https://www.linkedin.com/*",
    "https://*.reddit.com/*",
    "https://*.redd.it/*",
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://*.licdn.com/*",
    "http://localhost:41595/*",
    "http://127.0.0.1:41595/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
